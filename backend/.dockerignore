# Keeps the build context small and, more importantly, keeps secrets and host
# artifacts out of the image. node_modules is excluded so the container always
# installs for its own platform — a native module built on Windows will not run
# on Alpine.

node_modules
dist
*.tsbuildinfo

# Never copy real environment values into an image.
.env
.env.*
!.env.example

.git
.gitignore
*.md
coverage
.vscode
.idea
Dockerfile
.dockerignore
