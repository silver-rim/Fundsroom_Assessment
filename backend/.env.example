# =============================================================================
# BACKEND ENVIRONMENT — copy to backend/.env and fill in real values
# =============================================================================
#   cp .env.example .env          (from the backend/ directory)
#
# backend/.env is git-ignored. This file is committed and must never contain a
# real secret. See ../.env.example for the full system-wide reference.
# =============================================================================

# development | production | test
# Controls log verbosity and whether error responses include a stack trace.
NODE_ENV=development

# Port the Express server listens on.
PORT=4000

# --- Database ----------------------------------------------------------------
# Local PostgreSQL:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mini_erp_crm
#   DATABASE_SSL=false
# Neon / Render / Supabase (hosted):
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
#   DATABASE_SSL=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mini_erp_crm
DATABASE_SSL=false

# Maximum connections held in the pg pool. Keep this low on free tiers.
DATABASE_POOL_MAX=10

# --- Authentication ----------------------------------------------------------
# Signing key for JWTs (HS256). Minimum 32 characters — the app refuses to boot
# with anything shorter. Use a DIFFERENT value in every environment.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-0000000000000000

# Token lifetime. Accepts ms-style strings: 30m, 8h, 7d.
JWT_EXPIRES_IN=8h

# bcrypt cost factor. 10 is a good default; higher means slower logins.
BCRYPT_SALT_ROUNDS=10

# --- Logging -----------------------------------------------------------------
# Optional: debug | info | warn | error | silent.
# Leave unset to decide from NODE_ENV — production logs `info` and above,
# the test suite is silent, development logs everything.
# LOG_LEVEL=debug

# --- Testing -----------------------------------------------------------------
# Optional. `npm test` creates and uses "<your database>_test" by default, and
# refuses to run if that name is not distinct from DATABASE_URL's database —
# the suite truncates every table between test files.
# TEST_DATABASE_NAME=mini_erp_crm_test

# --- CORS --------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API.
# Production example: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# --- Seed data (development / demo databases only) ---------------------------
# Used only by `npm run seed`. If omitted, documented development defaults are
# used (see README). The seed script refuses to run when NODE_ENV=production
# unless ALLOW_PRODUCTION_SEED=true is also set.
SEED_ADMIN_PASSWORD=Admin@12345
SEED_SALES_PASSWORD=Sales@12345
SEED_WAREHOUSE_PASSWORD=Warehouse@12345
SEED_ACCOUNTS_PASSWORD=Accounts@12345
ALLOW_PRODUCTION_SEED=false
