# =============================================================================
# Mini ERP + CRM Operations Portal — environment variable reference
# =============================================================================
# This file is committed. It contains variable NAMES and SAFE PLACEHOLDERS only.
# Never commit a real secret, connection string, or password.
#
# Usage:
#   backend :  cp .env.example backend/.env     (then fill in the BACKEND block)
#   frontend:  cp .env.example frontend/.env    (then fill in the FRONTEND block)
#
# Each app also ships its own focused .env.example from Phase 1 onwards; this
# root file is the single place that documents every variable in the system.
# =============================================================================


# -----------------------------------------------------------------------------
# BACKEND  (backend/.env)
# -----------------------------------------------------------------------------

# Runtime mode: development | production | test
# Controls log verbosity and whether error responses include a stack trace.
NODE_ENV=development

# Port the Express server listens on.
PORT=4000

# PostgreSQL connection string.
# Local example : postgresql://postgres:postgres@localhost:5432/mini_erp_crm
# Neon example  : postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Require TLS for the database connection. true for hosted Postgres (Neon,
# Render, Supabase); false for a plain local install.
DATABASE_SSL=false

# Max connections in the pg pool. Keep low on free tiers.
DATABASE_POOL_MAX=10

# Secret used to sign JWTs (HS256). MUST be a long random string, and MUST be
# different in every environment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Token lifetime. Accepts zeit/ms strings: 30m, 8h, 7d.
JWT_EXPIRES_IN=8h

# Comma-separated list of browser origins allowed to call this API.
# Local example      : http://localhost:5173
# Production example : https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# bcrypt cost factor. 10 is a sensible default; higher is slower to log in.
BCRYPT_SALT_ROUNDS=10

# --- Seed passwords (development/demo databases only) ------------------------
# Used ONLY by `npm run seed` to hash the demo accounts. If a variable is
# omitted, the seed falls back to a documented development default.
# Never point the seed at a database that holds real data.
SEED_ADMIN_PASSWORD=change-me-admin
SEED_SALES_PASSWORD=change-me-sales
SEED_WAREHOUSE_PASSWORD=change-me-warehouse
SEED_ACCOUNTS_PASSWORD=change-me-accounts


# -----------------------------------------------------------------------------
# FRONTEND  (frontend/.env)
# -----------------------------------------------------------------------------
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# ⚠ Anything here is PUBLIC once the app is built. Never put a secret in this block.

# Base URL of the backend API, including the /api prefix.
# Local example      : http://localhost:4000/api
# Production example : https://mini-erp-crm-api.onrender.com/api
VITE_API_BASE_URL=http://localhost:4000/api

# Name shown in the sidebar and browser tab.
VITE_APP_NAME=Mini ERP + CRM
