{
  "name": "mini-erp-crm-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mini ERP + CRM Operations Portal - React admin UI",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
