# =============================================================================
# FRONTEND ENVIRONMENT — copy to frontend/.env and adjust
# =============================================================================
#   cp .env.example .env          (from the frontend/ directory)
#
# Vite only exposes variables prefixed with VITE_ to the browser, and it INLINES
# them into the built JavaScript. Everything in this file is therefore public
# once the app is deployed — never put a secret here.
# =============================================================================

# Base URL of the backend API, including the /api prefix.
# Local development : http://localhost:4000/api
# Production        : https://mini-erp-crm-api.onrender.com/api
VITE_API_BASE_URL=http://localhost:4000/api

# Product name shown in the sidebar and on the login screen.
VITE_APP_NAME=Mini ERP + CRM
